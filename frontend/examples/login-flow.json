{
  "version": "2.0",
  "name": "TaskFlow — Login",
  "target": "cypress",
  "baseUrl": "http://localhost:5174",
  "tags": ["auth", "smoke"],
  "rootSuiteId": "suite-root",
  "environments": [
    { "name": "local", "baseUrl": "http://localhost:5174" }
  ],
  "activeEnvironment": "local",
  "createdAt": "2026-05-12T00:00:00.000Z",
  "updatedAt": "2026-05-12T00:00:00.000Z",
  "nodes": {
    "suite-root": {
      "id": "suite-root",
      "kind": "suite",
      "name": "TaskFlow — Login",
      "parentId": null,
      "children": ["test-success", "test-error"],
      "hooks": {
        "beforeAll":  [],
        "beforeEach": ["hook-navigate"],
        "afterEach":  [],
        "afterAll":   []
      }
    },

    "hook-navigate": {
      "id": "hook-navigate",
      "kind": "hook",
      "hookKind": "beforeEach",
      "parentId": "suite-root",
      "steps": [
        {
          "id": "h1-s1",
          "command": {
            "id": "h1-c1",
            "name": "visit",
            "args": [{ "kind": "string", "value": "/login" }],
            "chain": []
          }
        }
      ]
    },

    "test-success": {
      "id": "test-success",
      "kind": "test",
      "name": "logs in with valid credentials",
      "parentId": "suite-root",
      "steps": [
        {
          "id": "s1",
          "label": "type email",
          "command": {
            "id": "c1",
            "name": "get",
            "args": [{ "kind": "selector", "value": { "strategy": "testId", "value": "login-email" } }],
            "chain": [
              { "id": "c1a", "name": "type", "args": [{ "kind": "string", "value": "demo@taskflow.io" }], "chain": [] }
            ]
          }
        },
        {
          "id": "s2",
          "label": "type password",
          "command": {
            "id": "c2",
            "name": "get",
            "args": [{ "kind": "selector", "value": { "strategy": "testId", "value": "login-password" } }],
            "chain": [
              { "id": "c2a", "name": "type", "args": [{ "kind": "string", "value": "demo1234" }], "chain": [] }
            ]
          }
        },
        {
          "id": "s3",
          "label": "click sign in",
          "command": {
            "id": "c3",
            "name": "get",
            "args": [{ "kind": "selector", "value": { "strategy": "testId", "value": "login-submit" } }],
            "chain": [
              { "id": "c3a", "name": "click", "args": [], "chain": [] }
            ]
          }
        },
        {
          "id": "s4",
          "label": "assert dashboard visible",
          "command": {
            "id": "c4",
            "name": "get",
            "args": [{ "kind": "selector", "value": { "strategy": "testId", "value": "dashboard-page" } }],
            "chain": [
              { "id": "c4a", "name": "should", "args": [{ "kind": "assertion", "assertion": "be.visible" }], "chain": [] }
            ]
          }
        }
      ]
    },

    "test-error": {
      "id": "test-error",
      "kind": "test",
      "name": "shows error for wrong credentials",
      "parentId": "suite-root",
      "steps": [
        {
          "id": "s5",
          "label": "type wrong email",
          "command": {
            "id": "c5",
            "name": "get",
            "args": [{ "kind": "selector", "value": { "strategy": "testId", "value": "login-email" } }],
            "chain": [
              { "id": "c5a", "name": "type", "args": [{ "kind": "string", "value": "wrong@example.com" }], "chain": [] }
            ]
          }
        },
        {
          "id": "s6",
          "label": "type wrong password",
          "command": {
            "id": "c6",
            "name": "get",
            "args": [{ "kind": "selector", "value": { "strategy": "testId", "value": "login-password" } }],
            "chain": [
              { "id": "c6a", "name": "type", "args": [{ "kind": "string", "value": "wrongpass" }], "chain": [] }
            ]
          }
        },
        {
          "id": "s7",
          "label": "click sign in",
          "command": {
            "id": "c7",
            "name": "get",
            "args": [{ "kind": "selector", "value": { "strategy": "testId", "value": "login-submit" } }],
            "chain": [
              { "id": "c7a", "name": "click", "args": [], "chain": [] }
            ]
          }
        },
        {
          "id": "s8",
          "label": "assert error message visible",
          "command": {
            "id": "c8",
            "name": "get",
            "args": [{ "kind": "selector", "value": { "strategy": "testId", "value": "login-error" } }],
            "chain": [
              { "id": "c8a", "name": "should", "args": [{ "kind": "assertion", "assertion": "be.visible" }], "chain": [] },
              { "id": "c8b", "name": "and", "args": [{ "kind": "assertion", "assertion": "contain.text", "expected": "Invalid" }], "chain": [] }
            ]
          }
        }
      ]
    }
  }
}
