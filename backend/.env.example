PORT=3001

# CORS: set to the exact origin of your deployed frontend.
# Local dev: http://localhost:5173
# Production: https://your-app.netlify.app  (no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173

# Runner mode: "mock" (default) or "cypress"
# mock: instant simulated execution, no browser required — good for demos
# cypress: real Cypress run against baseUrl — requires cypress in backend/node_modules
RUNNER=mock

# MockRunner only — 0 to 1, probability of each step failing (0 = always pass)
MOCK_FAILURE_RATE=0
