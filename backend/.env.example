PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Runner mode: "mock" (default) or "cypress"
# Set RUNNER=cypress to run tests in a real browser against the target app.
# Requires: npm install (cypress must be installed in backend/)
RUNNER=mock

# MockRunner only — 0 to 1, probability of each step failing
MOCK_FAILURE_RATE=0
